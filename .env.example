# Ember & Tide settings. Copy to `.env` next to docker-compose.yml, remove the leading # on what you want to change,
# and add `env_file: .env` under the embertide service. Every variable is explained in docs/configuration.md.
# Never commit your real .env: it can hold keys and passwords.

# --- Your place in the world ---
# Your IANA time zone, e.g. Europe/London, America/Chicago, Asia/Tokyo, Australia/Sydney. Schedules are local time.
# Unset = the machine's own zone, else UTC. Studio -> Your settings shows the zone in use.
# ET_TZ=
# TZ=

# --- Which bed? sim (try it without a bed), orion-mqtt (local, recommended) or orion-cloud ---
# ET_BED=sim
# ET_MQTT_URL=mqtt://mosquitto:1883
# ET_MQTT_CA_FILE=                # CA for an mqtts:// bed broker (the Orion hub itself only speaks plain 1883)
# ET_MQTT_TLS_INSECURE=off
# ET_ORION_SERIAL=
# ET_ORION_API_KEY=

# --- Server ---
# ET_DATA_DIR=./data
# ET_HOST=0.0.0.0
# ET_PORT=8790
# ET_WEB_DIR=
# ET_AUTH=on                      # off only for testing on a trusted machine
# ET_PUBLIC_URL=                  # how phones reach the server, e.g. https://sleep.example.com
# ET_TRUST_PROXY=off              # on only behind a reverse proxy or tunnel
# ET_PROXY_CLOUDFLARE=off         # on only when traffic comes through Cloudflare (trusts CF-Connecting-IP)
# ET_TRUSTED_PROXIES=             # CIDRs of your proxy, e.g. 172.18.0.0/16 (required with ET_AUTH_HEADER*)
# ET_AUTH_HEADER=                 # forward-auth username header, e.g. Remote-User (needs ET_TRUST_PROXY=on and ET_TRUSTED_PROXIES)
# ET_AUTH_HEADER_EMAIL=           # forward-auth email header, matched against usernames (needs both too)

# --- Optional integrations ---
# ET_HA_MQTT_URL=                 # Home Assistant's MQTT broker (mqtt:// or mqtts://)
# ET_HA_MQTT_CA_FILE=
# ET_HA_MQTT_TLS_INSECURE=off
# ET_HA_DISCOVERY_PREFIX=homeassistant
# ET_FCM_CREDENTIALS=             # your own Firebase service-account file, for Android push

# --- Optional AI assistant (nothing leaves the house unless you point this at a hosted service) ---
# ET_LLM_PROVIDER=openai          # openai (any OpenAI-compatible server) or anthropic
# ET_LLM_URL=                     # e.g. http://localhost:11434/v1
# ET_LLM_MODEL=
# ET_LLM_KEY=

# --- Testing ---
# ET_SIM_SPEED=1
# ET_TRACE=on

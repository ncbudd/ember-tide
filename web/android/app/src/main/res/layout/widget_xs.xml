    <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="–" android:textColor="#F2EADF" android:textSize="26sp" android:fontFamily="sans-serif-light" android:maxLines="1"/>
    <TextView android:id="@+id/w_state_short" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="" android:textColor="#A39AA4" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
